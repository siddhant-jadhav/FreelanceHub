rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. User profile photos
    match /users/{userId}/profile/{allPaths=**} {
      allow read: if true; // Publicly accessible profile avatars
      allow write: if isOwner(userId) &&
        request.resource.size < 5 * 1024 * 1024 && // 5MB max
        request.resource.contentType.matches('image/.*');
    }

    // 2. Freelancer portfolio assets
    match /freelancers/{userId}/portfolio/{allPaths=**} {
      allow read: if true; // Publicly visible portfolio showcases
      allow write: if isOwner(userId) &&
        request.resource.size < 15 * 1024 * 1024; // 15MB max
    }

    // 3. Task attachments (client briefs)
    match /tasks/{taskId}/attachments/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 25 * 1024 * 1024; // 25MB max
    }

    // 4. Project deliverables
    match /projects/{projectId}/deliverables/{allPaths=**} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() &&
        request.resource.size < 100 * 1024 * 1024; // 100MB max for deliverables
    }
  }
}
