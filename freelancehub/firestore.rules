rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isClient() {
      return isAuthenticated() && getUserData().role == 'client';
    }

    function isFreelancer() {
      return isAuthenticated() && getUserData().role == 'freelancer';
    }

    // 1. Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false; // Disallow raw user deletion from client
    }

    // 2. Freelancers collection
    match /freelancers/{freelancerId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(freelancerId) && isFreelancer();
      allow update: if isOwner(freelancerId);
      allow delete: if false;
    }

    // 3. Clients collection
    match /clients/{clientId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(clientId) && isClient();
      allow update: if isOwner(clientId);
      allow delete: if false;
    }

    // 4. Tasks collection (Buyer requests & opportunities)
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isClient() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        // Allow freelancers to increment offersCount atomically
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offersCount', 'updatedAt'])
      );
      allow delete: if isAuthenticated() && resource.data.clientId == request.auth.uid;
    }

    // 5. Proposals collection
    match /proposals/{proposalId} {
      allow read: if isAuthenticated() && (
        resource.data.freelancerId == request.auth.uid ||
        resource.data.clientId == request.auth.uid
      );
      allow create: if isAuthenticated() && isFreelancer() && request.resource.data.freelancerId == request.auth.uid;
      allow update: if isAuthenticated() && (
        // Client can accept/reject
        resource.data.clientId == request.auth.uid ||
        // Freelancer can withdraw/update pitch before acceptance
        resource.data.freelancerId == request.auth.uid
      );
      allow delete: if false;
    }

    // 6. Projects collection
    match /projects/{projectId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.freelancerId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.freelancerId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.freelancerId == request.auth.uid
      );
      allow delete: if false;
    }

    // 7. Milestones collection
    match /milestones/{milestoneId} {
      function getProjectData(projId) {
        return get(/databases/$(database)/documents/projects/$(projId)).data;
      }

      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        getProjectData(resource.data.projectId).clientId == request.auth.uid ||
        getProjectData(resource.data.projectId).freelancerId == request.auth.uid
      );
      allow delete: if false;
    }

    // 8. Conversations collection
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow create: if isAuthenticated() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participantIds;
      allow delete: if false;
    }

    // 9. Messages collection
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.receiverId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead'])
      );
      allow delete: if false;
    }

    // 10. Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
    }

    // 11. Payments collection (Escrow & Transactions)
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.freelancerId == request.auth.uid
      );
      // Client can fund escrow, but state transitions are protected
      allow create: if isAuthenticated() && request.resource.data.clientId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.freelancerId == request.auth.uid
      );
      allow delete: if false; // Financial audit trail cannot be deleted
    }

    // 12. Reviews collection
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isClient() && request.resource.data.clientId == request.auth.uid;
      allow update: if false; // Reviews cannot be altered once posted
      allow delete: if false;
    }
  }
}
